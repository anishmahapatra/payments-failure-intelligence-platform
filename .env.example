APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://payment_user:payment_pass@postgres:5432/payment_intelligence
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=payment-batch-jobs

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=payment-failure-intelligence
MODEL_ARTIFACT_PATH=training/artifacts/model_bundle.joblib
MODEL_VERSION=heuristic-v1

PROMETHEUS_ENABLED=true
FEAST_REPO_PATH=feature_repo
USE_FEAST_ONLINE_LOOKUP=false

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_ATTEMPTS=3

